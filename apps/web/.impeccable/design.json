  "narrative": {
    "northStar": "Gantry Signage",
    "overview": "The interface reads like airport and rail wayfinding. Surfaces are flat panels cut from four materials, signal yellow, black, white and sign green, each held by a 2px black edge. Nothing floats and nothing blurs. Type is one family, Overpass, set at Black weight and tight leading for anything that names a place, a price or a count. Meaning travels by shape before colour: a state is a solid, dashed or struck outline, a connector is an arrow, a kind of space is a drawn pictogram.",
    "keyCharacteristics": [
      "Four materials only: signal yellow, black, white, sign green; fields are full-bleed and separated by a 2px black rule.",
      "2px black edge on every panel, 0 to 4px corners, zero blur shadows.",
      "Overpass Variable throughout; Black (900) set solid for display and numerals.",
      "State by outline shape: solid, dashed, struck.",
      "Authored SVG pictograms and a solid arrow replace icon libraries."
    ],
    "rules": [
      {
        "name": "The Four Materials Rule",
        "body": "Backgrounds are signal, black, white or sign green. Status tints appear only inside badges and error text.",
        "section": "colors"
      },
      {
        "name": "The Ink-On-Field Rule",
        "body": "Black text on signal and white; signal text on black; white text on green. Signal never sits on white as text.",
        "section": "colors"
      },
      {
        "name": "The Solid Setting Rule",
        "body": "Anything that names a place, price or count is Black weight with leading at or below 1.05 and tracking -0.03em.",
        "section": "typography"
      },
      {
        "name": "The Tabular Number Rule",
        "body": "Prices, night counts and stat figures use tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "A raised surface is a white or coloured panel with a 2px black edge. Hover changes fill, never adds a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do separate sections with full-bleed colour fields and a 2px black rule.",
      "Do carry state by outline shape (solid, dashed, struck) as well as colour.",
      "Do set places, prices and counts in Black weight, solid leading, tabular numerals.",
      "Do use the authored Pictogram and Arrow components for kind-of-space and connection; add glyphs to the same 32 grid.",
      "Do keep every focus ring two-layer, and flip the focus colour to the field's contrast partner.",
      "Do write user-facing strings through t()."
    ],
    "donts": [
      "Don't add blur shadows, gradients, rounded pills or glass; radii stay 0 to 4px.",
      "Don't introduce a fifth surface colour or colour-only status.",
      "Don't put signal-coloured text on white.",
      "Don't use icon fonts or third-party icon sets for wayfinding glyphs."
    ]
