# Secret used to sign and verify JWT access tokens. Required.
# Use a long random value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET="dev-only-change-me"

# Postgres connection (shared with packages/db). Copy from packages/db/.env.example.
DATABASE_URL="postgresql://nomadhome:nomadhome@localhost:5432/nomadhome?schema=public"

# Comma-separated list of allowed CORS origins. Required in production.
# e.g. CORS_ORIGIN="https://your-app.vercel.app"
CORS_ORIGIN="http://localhost:5173"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_SUCCESS_URL="http://localhost:5173/booking/success"
STRIPE_CANCEL_URL="http://localhost:5173/listings"
