# Secret used to sign and verify JWT access tokens. Required.
# Use a long random value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET="dev-only-change-me"

# Postgres connection (shared with packages/db). Copy from packages/db/.env.example.
DATABASE_URL="postgresql://nomadhome:nomadhome@localhost:5432/nomadhome?schema=public"
