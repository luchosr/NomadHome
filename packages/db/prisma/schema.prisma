// NomadHome Prisma schema.
//
// Domain models are added per capability ticket. `docs/data-model.md` is the
// canonical reference for the model; this schema is the runtime source of truth
// once code exists (openspec/project.md §6).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ---------------------------------------------------------------------------
// Identity context (docs/data-model.md §3.1–3.5)
// ---------------------------------------------------------------------------

/// Authoritative account record. Roles are an array so one account can hold
/// several (e.g. ["guest", "host"]).
model User {
  id              String    @id @default(uuid())
  email           String    @unique @db.Citext
  passwordHash    String
  roles           String[]  @default(["guest"])
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  emailVerificationTokens EmailVerificationToken[]
  authAuditEvents         AuthAuditEvent[]
  refreshTokens           RefreshToken[]
  hostProfile             HostProfile?
  listings                Listing[]
}

/// 1:1 with User, created when a guest upgrades to host (docs/data-model.md §3.2).
model HostProfile {
  userId               String   @id
  displayName          String
  payoutEmail          String
  acceptedTermsVersion String
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Listings context (docs/data-model.md §3.6–3.9)
// ---------------------------------------------------------------------------

/// Host-owned bookable inventory. Aggregate root for amenities, photos, and
/// availability. Lat/long stay null until geocoding lands.
model Listing {
  id               String        @id @default(uuid())
  hostId           String
  title            String
  description      String
  type             ListingType
  city             String
  country          String
  addressLine      String
  latitude         Decimal?      @db.Decimal(9, 6)
  longitude        Decimal?      @db.Decimal(9, 6)
  capacity         Int
  nightlyRateCents Int
  currency         String        @default("USD")
  status           ListingStatus @default(DRAFT)
  averageRating    Decimal?      @db.Decimal(3, 2)
  reviewCount      Int           @default(0)
  disabledAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  host      User             @relation(fields: [hostId], references: [id])
  amenities ListingAmenity[]
  photos    ListingPhoto[]

  @@index([hostId])
}

/// Ordered photo for a listing. Position is unique per listing (enforced by DB).
/// Object deletion from storage is handled at the storage layer, not by the API.
model ListingPhoto {
  id        String   @id @default(uuid())
  listingId String
  url       String
  position  Int
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@index([listingId])
}

/// Amenity lookup, seeded by seed.ts.
model Amenity {
  code  String @id
  label String

  listings ListingAmenity[]
}

/// Join between a listing and its amenities.
model ListingAmenity {
  listingId   String
  amenityCode String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityCode], references: [code])

  @@id([listingId, amenityCode])
}

enum ListingType {
  PROPERTY
  WORKSPACE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

/// Server-side revocable refresh token (docs/data-model.md §3.3). 30-day
/// absolute TTL from issuance; only the hash is stored, never the raw token.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use token issued at registration to verify email ownership.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only audit trail for authentication events.
model AuthAuditEvent {
  id        String             @id @default(uuid())
  userId    String?
  event     AuthAuditEventType
  ipAddress String
  userAgent String?
  metadata  Json?
  createdAt DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum AuthAuditEventType {
  registered
  registration_failed
  login_succeeded
  login_failed
  refresh_token_reuse_detected
  password_reset_requested
  role_added
  user_disabled
}
