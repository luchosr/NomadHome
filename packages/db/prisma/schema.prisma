// NomadHome Prisma schema.
//
// Domain models are added per capability ticket. `docs/data-model.md` is the
// canonical reference for the model; this schema is the runtime source of truth
// once code exists (openspec/project.md §6).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, btree_gist]
}

// ---------------------------------------------------------------------------
// Identity context (docs/data-model.md §3.1–3.5)
// ---------------------------------------------------------------------------

/// Authoritative account record. Roles are an array so one account can hold
/// several (e.g. ["guest", "host"]).
model User {
  id              String    @id @default(uuid())
  email           String    @unique @db.Citext
  passwordHash    String
  roles           String[]  @default(["guest"])
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  emailVerificationTokens EmailVerificationToken[]
  authAuditEvents         AuthAuditEvent[]
  refreshTokens           RefreshToken[]
  hostProfile             HostProfile?
  listings                Listing[]
  guestBookings           Booking[]                @relation("GuestBookings")
  hostBookings            Booking[]                @relation("HostBookings")
  payouts                 Payout[]
}

/// 1:1 with User, created when a guest upgrades to host (docs/data-model.md §3.2).
model HostProfile {
  userId               String   @id
  displayName          String
  payoutEmail          String
  acceptedTermsVersion String
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Listings context (docs/data-model.md §3.6–3.9)
// ---------------------------------------------------------------------------

/// Host-owned bookable inventory. Aggregate root for amenities, photos, and
/// availability. Lat/long stay null until geocoding lands.
model Listing {
  id               String        @id @default(uuid())
  hostId           String
  title            String
  description      String
  type             ListingType
  city             String
  country          String
  addressLine      String
  latitude         Decimal?      @db.Decimal(9, 6)
  longitude        Decimal?      @db.Decimal(9, 6)
  capacity         Int
  nightlyRateCents Int
  currency         String        @default("USD")
  status           ListingStatus @default(DRAFT)
  averageRating    Decimal?      @db.Decimal(3, 2)
  reviewCount      Int           @default(0)
  disabledAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  host               User                @relation(fields: [hostId], references: [id])
  amenities          ListingAmenity[]
  photos             ListingPhoto[]
  availabilityBlocks AvailabilityBlock[]
  bookings           Booking[]

  @@index([hostId])
}

/// Ordered photo for a listing. Position is unique per listing (enforced by DB).
/// Object deletion from storage is handled at the storage layer, not by the API.
model ListingPhoto {
  id        String   @id @default(uuid())
  listingId String
  url       String
  position  Int
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@index([listingId])
}

/// Amenity lookup, seeded by seed.ts.
model Amenity {
  code  String @id
  label String

  listings ListingAmenity[]
}

/// Join between a listing and its amenities.
model ListingAmenity {
  listingId   String
  amenityCode String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityCode], references: [code])

  @@id([listingId, amenityCode])
}

enum ListingType {
  PROPERTY
  WORKSPACE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

/// Blocks a date range on a listing. The EXCLUDE constraint (added manually in the
/// migration) prevents overlapping blocks at the DB level (Postgres error 23P01).
/// bookingId references Booking when source = BOOKING_HOLD.
model AvailabilityBlock {
  id        String                  @id @default(uuid())
  listingId String
  startDate DateTime                @db.Date
  endDate   DateTime                @db.Date
  source    AvailabilityBlockSource
  bookingId String?  @unique
  createdAt DateTime @default(now())

  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([listingId])
}

enum AvailabilityBlockSource {
  HOST_BLOCK
  BOOKING_HOLD
  ADMIN_BLOCK
}

/// Server-side revocable refresh token (docs/data-model.md §3.3). 30-day
/// absolute TTL from issuance; only the hash is stored, never the raw token.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use token issued at registration to verify email ownership.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only audit trail for authentication events.
model AuthAuditEvent {
  id        String             @id @default(uuid())
  userId    String?
  event     AuthAuditEventType
  ipAddress String
  userAgent String?
  metadata  Json?
  createdAt DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum AuthAuditEventType {
  registered
  registration_failed
  login_succeeded
  login_failed
  refresh_token_reuse_detected
  password_reset_requested
  role_added
  user_disabled
}

// ---------------------------------------------------------------------------
// Booking context (docs/data-model.md §3.11–3.14)
// ---------------------------------------------------------------------------

/// Reservation aggregate root. Fee fields are snapshotted at creation and never updated.
model Booking {
  id                     String        @id @default(uuid())
  listingId              String
  guestId                String
  hostId                 String
  checkIn                DateTime      @db.Date
  checkOut               DateTime      @db.Date
  nights                 Int
  nightlyRateCents       Int
  subtotalCents          Int
  guestServiceFeeBps     Int
  guestServiceFeeCents   Int
  hostCommissionBps      Int
  hostCommissionCents    Int
  currency               String
  totalChargedCents      Int
  payoutCents            Int
  status                 BookingStatus @default(PENDING_PAYMENT)
  stripeCheckoutSessionId String?
  stripePaymentIntentId  String?
  confirmedAt            DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  createdAt              DateTime      @default(now())

  listing          Listing            @relation(fields: [listingId], references: [id])
  guest            User               @relation("GuestBookings", fields: [guestId], references: [id])
  host             User               @relation("HostBookings", fields: [hostId], references: [id])
  availabilityHold AvailabilityBlock?
  refundRequest    RefundRequest?
  payoutBooking    PayoutBooking?

  @@index([guestId, status])
  @@index([hostId, status, checkIn])
  @@index([listingId, status])
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

/// Active platform fee configuration. Latest row by createdAt is authoritative.
model PlatformFeeConfig {
  id                 String   @id @default(uuid())
  guestServiceFeeBps Int
  hostCommissionBps  Int
  createdAt          DateTime @default(now())
  createdBy          String
}

/// Refund record created on cancellation; admin executes the actual refund.
model RefundRequest {
  id          String              @id @default(uuid())
  bookingId   String              @unique
  amountCents Int
  currency    String
  status      RefundRequestStatus @default(PENDING_ADMIN)
  reason      String?
  createdAt   DateTime            @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
}

enum RefundRequestStatus {
  PENDING_ADMIN
  PROCESSED
}

// ---------------------------------------------------------------------------
// Payments context (docs/data-model.md §3.15–3.17)
// ---------------------------------------------------------------------------

/// Idempotency ledger for Stripe webhook events. Prevents double-processing
/// on Stripe retries (at-least-once delivery).
model StripeProcessedEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  eventType     String
  bookingId     String?
  processedAt   DateTime @default(now())
}

/// Admin-recorded manual payout to a host (bank transfer, Wise, etc.).
model Payout {
  id                String         @id @default(uuid())
  hostId            String
  amountCents       Int
  currency          String
  method            String
  externalReference String
  createdAt         DateTime       @default(now())
  createdBy         String

  host          User           @relation(fields: [hostId], references: [id])
  payoutBookings PayoutBooking[]

  @@index([hostId])
}

/// Join between a Payout and the Bookings it covers. bookingId @unique
/// enforces one-settlement-per-booking at the DB level.
model PayoutBooking {
  id        String @id @default(uuid())
  payoutId  String
  bookingId String @unique

  payout  Payout  @relation(fields: [payoutId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([payoutId])
}
