# NomadHome — environment variable template.
# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL="postgresql://nomadhome:nomadhome@localhost:5432/nomadhome"

# --- Auth ---
JWT_SECRET="change-me-min-32-chars"

# --- Cloudflare R2 (listing photos) ---
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="nomadhome-photos"
R2_PUBLIC_URL="https://photos.nomadhome.example.com"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_SUCCESS_URL="https://app.nomadhome.example.com/booking/success"
STRIPE_CANCEL_URL="https://app.nomadhome.example.com/listings"
