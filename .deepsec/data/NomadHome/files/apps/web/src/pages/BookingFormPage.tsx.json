  "findings": [
    {
      "severity": "BUG",
      "vulnSlug": "other-logic-bug",
      "title": "computeNights renders NaN total for invalid/unparseable date params",
      "description": "checkIn/checkOut come from URL search params and are only guarded by hasDates (length > 0), never validated as dates. If a user opens /listings/:id/book?checkIn=x&checkOut=y with unparseable values, new Date(...) yields NaN, so computeNights returns NaN (Math.max(0, NaN) === NaN) and the displayed total becomes '$NaN'. No security or financial impact — the actual charge is computed server-side and invalid dates are rejected at booking creation — but it is a broken-display logic gap reachable by editing the URL.",
      "lineNumbers": [14, 15, 16, 17, 29, 78, 79],
      "recommendation": "Validate checkIn/checkOut as real ISO dates (e.g. Zod date parse or Number.isNaN(new Date(x).getTime())) before rendering; fall back to the 'select dates' state when they don't parse or checkOut <= checkIn.",
      "confidence": "medium",
      "producedByRunId": "20260717095347-0766c6f11f0620e6"
    }
  ],
